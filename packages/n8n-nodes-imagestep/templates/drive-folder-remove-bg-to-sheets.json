{
  "name": "ImageStep — Drive folder → remove background → Sheets",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "triggerOn": "specificFolder",
        "folderToWatch": { "__rl": true, "mode": "list", "value": "REPLACE_WITH_DRIVE_FOLDER_ID", "cachedResultName": "product-photos" },
        "event": "fileCreated",
        "options": {}
      },
      "id": "5b1a1a9c-0001-4a2c-9c2e-000000000001",
      "name": "Google Drive Trigger",
      "type": "n8n-nodes-base.googleDriveTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "credentials": { "googleDriveOAuth2Api": { "id": "REPLACE_ME", "name": "Google Drive account" } }
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": { "__rl": true, "mode": "id", "value": "={{ $json.id }}" },
        "options": { "binaryPropertyName": "data" }
      },
      "id": "5b1a1a9c-0002-4a2c-9c2e-000000000002",
      "name": "Download File",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [240, 0],
      "credentials": { "googleDriveOAuth2Api": { "id": "REPLACE_ME", "name": "Google Drive account" } }
    },
    {
      "parameters": {
        "resource": "op",
        "operation": "run",
        "op": "remove_bg",
        "inputMode": "binary",
        "binaryProperty": "data",
        "parameters": "{}",
        "dryRun": false,
        "storeResult": true,
        "wait": true,
        "waitSeconds": 180,
        "publish": true,
        "downloadOutput": false,
        "options": { "collection": "drive-cutouts" }
      },
      "id": "5b1a1a9c-0003-4a2c-9c2e-000000000003",
      "name": "Remove Background",
      "type": "n8n-nodes-imagestep.imageStep",
      "typeVersion": 1,
      "position": [480, 0],
      "credentials": { "imageStepApi": { "id": "REPLACE_ME", "name": "ImageStep account" } }
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": { "__rl": true, "mode": "list", "value": "REPLACE_WITH_SPREADSHEET_ID", "cachedResultName": "Cutouts" },
        "sheetName": { "__rl": true, "mode": "list", "value": "gid=0", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "file": "={{ $('Google Drive Trigger').item.json.name }}",
            "driveFileId": "={{ $('Google Drive Trigger').item.json.id }}",
            "assetId": "={{ $json.outputs[0].assetId }}",
            "publicUrl": "={{ $json.outputs[0].publicUrl }}",
            "jobId": "={{ $json.jobId }}",
            "creditsCharged": "={{ $json.creditsCharged }}"
          },
          "matchingColumns": [],
          "schema": [
            { "id": "file", "displayName": "file", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "driveFileId", "displayName": "driveFileId", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "assetId", "displayName": "assetId", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "publicUrl", "displayName": "publicUrl", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "jobId", "displayName": "jobId", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "creditsCharged", "displayName": "creditsCharged", "type": "number", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": false }
          ]
        },
        "options": {}
      },
      "id": "5b1a1a9c-0004-4a2c-9c2e-000000000004",
      "name": "Append Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [720, 0],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    }
  ],
  "connections": {
    "Google Drive Trigger": { "main": [[{ "node": "Download File", "type": "main", "index": 0 }]] },
    "Download File": { "main": [[{ "node": "Remove Background", "type": "main", "index": 0 }]] },
    "Remove Background": { "main": [[{ "node": "Append Row", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
}
