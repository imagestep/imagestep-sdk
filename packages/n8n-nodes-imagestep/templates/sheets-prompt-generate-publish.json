{
  "name": "ImageStep — Sheets prompt → generate → publish → write URL back",
  "nodes": [
    {
      "parameters": {
        "pollTimes": { "item": [{ "mode": "everyMinute" }] },
        "documentId": { "__rl": true, "mode": "list", "value": "REPLACE_WITH_SPREADSHEET_ID", "cachedResultName": "Prompts" },
        "sheetName": { "__rl": true, "mode": "list", "value": "gid=0", "cachedResultName": "Sheet1" },
        "event": "rowAdded",
        "options": {}
      },
      "id": "7c2b2b8d-0001-4d3e-8f1a-000000000001",
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [0, 0],
      "credentials": { "googleSheetsTriggerOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets Trigger account" } }
    },
    {
      "parameters": {
        "resource": "op",
        "operation": "run",
        "op": "generate",
        "inputMode": "none",
        "prompt": "={{ $json.prompt }}",
        "count": 1,
        "parameters": "={{ JSON.stringify({ aspectRatio: $json.aspectRatio || '1:1' }) }}",
        "dryRun": false,
        "storeResult": true,
        "wait": true,
        "waitSeconds": 240,
        "publish": true,
        "downloadOutput": false,
        "options": { "collection": "sheet-generations" }
      },
      "id": "7c2b2b8d-0002-4d3e-8f1a-000000000002",
      "name": "Generate Image",
      "type": "n8n-nodes-imagestep.imageStep",
      "typeVersion": 1,
      "position": [240, 0],
      "credentials": { "imageStepApi": { "id": "REPLACE_ME", "name": "ImageStep account" } }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": { "__rl": true, "mode": "list", "value": "REPLACE_WITH_SPREADSHEET_ID", "cachedResultName": "Prompts" },
        "sheetName": { "__rl": true, "mode": "list", "value": "gid=0", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $('Google Sheets Trigger').item.json.row_number }}",
            "imageUrl": "={{ $json.outputs[0].publicUrl }}",
            "assetId": "={{ $json.outputs[0].assetId }}",
            "status": "={{ $json.status }}"
          },
          "matchingColumns": ["row_number"],
          "schema": [
            { "id": "row_number", "displayName": "row_number", "type": "number", "required": false, "defaultMatch": true, "display": true, "canBeUsedToMatch": true, "readOnly": true, "removed": false },
            { "id": "prompt", "displayName": "prompt", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "aspectRatio", "displayName": "aspectRatio", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "imageUrl", "displayName": "imageUrl", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "assetId", "displayName": "assetId", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true },
            { "id": "status", "displayName": "status", "type": "string", "required": false, "defaultMatch": false, "display": true, "canBeUsedToMatch": true }
          ]
        },
        "options": {}
      },
      "id": "7c2b2b8d-0003-4d3e-8f1a-000000000003",
      "name": "Write URL Back",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [480, 0],
      "credentials": { "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" } }
    }
  ],
  "connections": {
    "Google Sheets Trigger": { "main": [[{ "node": "Generate Image", "type": "main", "index": 0 }]] },
    "Generate Image": { "main": [[{ "node": "Write URL Back", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" },
  "pinData": {},
  "meta": { "templateCredsSetupCompleted": false }
}
