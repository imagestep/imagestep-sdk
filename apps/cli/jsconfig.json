{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "#commands/*": ["src/commands/*"]
    },
    "module": "ESNext",
    "moduleResolution": "node",
    "checkJs": false,
    "noImplicitAny": false,
    "allowUnusedLabels": false,
    "allowUnreachableCode": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/**/*", "bin/**/*"],
  "exclude": ["node_modules"]
}
