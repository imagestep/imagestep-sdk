{
  "name": "ImageStep recipe — product scenes: Sheet row → the same product in a new scene → Instagram size → URL back",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "cachedResultName": "Product scenes"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "gid=0",
          "cachedResultName": "Sheet1"
        },
        "event": "rowAdded",
        "options": {}
      },
      "id": "b2c3d4e5-0001-4c00-8000-000000000001",
      "name": "Google Sheets Trigger",
      "type": "n8n-nodes-base.googleSheetsTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "credentials": {
        "googleSheetsTriggerOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets Trigger account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// The row says where the product is; the preset's subject says what the product is. {{subject.product}} is expanded\n// by ImageStep to the words saved on the preset — built here, in code, because n8n reads {{ }} in a field as its own.\nreturn $input.all().map((item) => ({\n  json: {\n    row_number: item.json.row_number,\n    prompt: `{{subject.product}} ${item.json.scene}. Product photography, the product sharp and fully in frame, no text.`\n  }\n}));"
      },
      "id": "b2c3d4e5-0002-4c00-8000-000000000002",
      "name": "Build the Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        0
      ]
    },
    {
      "parameters": {
        "resource": "preset",
        "operation": "run",
        "preset": "product-scenes",
        "presetVersion": 0,
        "inputMode": "none",
        "prompt": "={{ $json.prompt }}",
        "count": 1,
        "dryRun": false,
        "storeResult": true,
        "wait": true,
        "waitSeconds": 180,
        "publish": false,
        "options": {
          "collection": "product-scenes"
        }
      },
      "id": "b2c3d4e5-0003-4c00-8000-000000000003",
      "name": "Generate the Scene",
      "type": "n8n-nodes-imagestep.imageStep",
      "typeVersion": 1,
      "position": [
        520,
        0
      ],
      "credentials": {
        "imageStepApi": {
          "id": "REPLACE_ME",
          "name": "ImageStep account"
        }
      }
    },
    {
      "parameters": {
        "resource": "op",
        "operation": "run",
        "op": "resize",
        "inputMode": "assetIds",
        "assetIds": "={{ $json.outputs[0].assetId }}",
        "parameters": "{\"width\": 1080, \"height\": 1350, \"fit\": \"cover\", \"gravity\": \"attention\", \"withoutEnlargement\": false}",
        "dryRun": false,
        "storeResult": true,
        "wait": true,
        "waitSeconds": 120,
        "publish": true,
        "downloadOutput": false,
        "options": {
          "collection": "product-scenes"
        }
      },
      "id": "b2c3d4e5-0004-4c00-8000-000000000004",
      "name": "Instagram Size (4:5)",
      "type": "n8n-nodes-imagestep.imageStep",
      "typeVersion": 1,
      "position": [
        780,
        0
      ],
      "credentials": {
        "imageStepApi": {
          "id": "REPLACE_ME",
          "name": "ImageStep account"
        }
      }
    },
    {
      "parameters": {
        "operation": "update",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "cachedResultName": "Product scenes"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "gid=0",
          "cachedResultName": "Sheet1"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "row_number": "={{ $('Build the Prompt').item.json.row_number }}",
            "url": "={{ $json.outputs[0].publicUrl }}",
            "jobId": "={{ $json.jobId }}",
            "status": "={{ $json.status }}"
          },
          "matchingColumns": [
            "row_number"
          ],
          "schema": [
            {
              "id": "row_number",
              "displayName": "row_number",
              "type": "number",
              "required": false,
              "defaultMatch": true,
              "display": true,
              "canBeUsedToMatch": true,
              "readOnly": true,
              "removed": false
            },
            {
              "id": "scene",
              "displayName": "scene",
              "type": "string",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true
            },
            {
              "id": "url",
              "displayName": "url",
              "type": "string",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true
            },
            {
              "id": "jobId",
              "displayName": "jobId",
              "type": "string",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true
            },
            {
              "id": "status",
              "displayName": "status",
              "type": "string",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "canBeUsedToMatch": true
            }
          ]
        },
        "options": {}
      },
      "id": "b2c3d4e5-0005-4c00-8000-000000000005",
      "name": "Write Back to the Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1040,
        0
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      }
    }
  ],
  "connections": {
    "Google Sheets Trigger": {
      "main": [
        [
          {
            "node": "Build the Prompt",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build the Prompt": {
      "main": [
        [
          {
            "node": "Generate the Scene",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Generate the Scene": {
      "main": [
        [
          {
            "node": "Instagram Size (4:5)",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Instagram Size (4:5)": {
      "main": [
        [
          {
            "node": "Write Back to the Row",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
