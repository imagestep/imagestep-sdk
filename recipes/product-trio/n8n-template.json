        "dryRun": false,
        "storeResult": true,
        "wait": true,
        "waitSeconds": 120,
        "publish": true,
        "downloadOutput": false,
        "options": {
          "collection": "product-trio"
        }
      },
      "id": "b2c3d4e5-0005-4c00-8000-000000000005",
