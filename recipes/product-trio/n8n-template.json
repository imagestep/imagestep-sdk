      "type": "n8n-nodes-imagestep.imageStep",
      "typeVersion": 1,
      "position": [
        680,
        200
      ],
      "credentials": {
        "imageStepApi": {
          "id": "REPLACE_ME",
          "name": "ImageStep account"
        }
