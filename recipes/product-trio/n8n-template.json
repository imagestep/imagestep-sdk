    },
    {
      "parameters": {
        "numberInputs": 3
      },
      "id": "b2c3d4e5-0007-4c00-8000-000000000007",
      "name": "Merge",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [
        940,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "// One sheet row per variant of the photo that triggered this run: each branch is one job, and its op says which.\nconst file = $('New Product Photo').first().json.name;\nconst VARIANT = { remove_bg: 'cutout', pad: 'packshot', resize: 'web' };\nreturn $input.all().map((item) => {\n  const out = item.json.outputs?.[0] || {};\n  return {\n    json: { file, variant: VARIANT[item.json.op] || item.json.op, assetId: out.assetId, publicUrl: out.publicUrl, width: out.width, height: out.height, jobId: item.json.jobId }\n  };\n});"
      },
      "id": "b2c3d4e5-0008-4c00-8000-000000000008",
      "name": "One Row Per Variant",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1160,
        200
      ]
    },
    {
      "parameters": {
        "operation": "append",
        "documentId": {
          "__rl": true,
          "mode": "list",
          "value": "REPLACE_WITH_SPREADSHEET_ID",
          "cachedResultName": "Product variants"
        },
        "sheetName": {
          "__rl": true,
          "mode": "list",
          "value": "gid=0",
          "cachedResultName": "Sheet1"
        },
        "columns": {
          "mappingMode": "autoMapInputData",
          "value": {},
          "matchingColumns": [],
          "schema": [
