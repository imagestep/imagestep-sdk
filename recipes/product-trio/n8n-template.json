      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "resource": "asset",
        "operation": "upload",
        "binaryProperty": "data",
        "waitForReady": true,
        "collection": "product-trio"
      },
      "id": "b2c3d4e5-0003-4c00-8000-000000000003",
      "name": "Upload Once",
      "type": "n8n-nodes-imagestep.imageStep",
      "typeVersion": 1,
      "position": [
        440,
        200
      ],
      "credentials": {
        "imageStepApi": {
          "id": "REPLACE_ME",
          "name": "ImageStep account"
        }
      }
    },
    {
      "parameters": {
        "resource": "op",
        "operation": "run",
        "op": "remove_bg",
        "inputMode": "assetIds",
        "assetIds": "={{ $json.assetId }}",
        "parameters": "{}",
        "dryRun": false,
        "storeResult": true,
        "wait": true,
        "waitSeconds": 240,
        "publish": true,
        "downloadOutput": false,
        "options": {
          "collection": "product-trio"
        }
      },
      "id": "b2c3d4e5-0004-4c00-8000-000000000004",
