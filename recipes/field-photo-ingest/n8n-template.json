    },
    {
      "parameters": {
        "resource": "asset",
        "operation": "get",
        "assetId": "={{ $json.assetId }}"
      },
      "id": "c3d4e5f6-0004-4c00-8000-000000000004",
      "name": "Read Metadata",
      "type": "n8n-nodes-imagestep.imageStep",
      "typeVersion": 1,
      "position": [
        660,
        0
      ],
      "credentials": {
        "imageStepApi": {
          "id": "REPLACE_ME",
          "name": "ImageStep account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Date + GPS → the collection `YYYY-MM/<lat,lon>` (3 decimals ≈ 100 m). No reverse geocoding. The asset's metadata\n// carries exiftool's names: DateTimeOriginal as an ISO-8601 instant, GPSLatitude / GPSLongitude as signed decimals.\nreturn $input.all().map((item) => {\n  const a = item.json;\n  const m = a.metadata || {};\n  const taken = m.DateTimeOriginal ? new Date(m.DateTimeOriginal) : null;\n  const month = taken && !isNaN(taken) ? taken.toISOString().slice(0, 7) : 'unknown-date';\n  const lat = parseFloat(m.GPSLatitude), lon = parseFloat(m.GPSLongitude);\n  const hasGps = Number.isFinite(lat) && Number.isFinite(lon);\n  return {\n    json: {\n      file: $('New Field Photo').item.json.name,\n      assetId: a.assetId,\n      takenAt: month === 'unknown-date' ? '' : taken.toISOString(),\n      latitude: hasGps ? lat : '',\n      longitude: hasGps ? lon : '',\n      collection: `${month}/${hasGps ? `${lat.toFixed(3)},${lon.toFixed(3)}` : 'no-gps'}`,\n      width: a.width,\n      height: a.height\n    }\n  };\n});"
      },
      "id": "c3d4e5f6-0005-4c00-8000-000000000005",
      "name": "Date & Place Collection",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.imagestep.dev/api/v1/assets/update",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "imageStepApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ ids: [$json.assetId], collection: $json.collection, published: true }) }}",
        "options": {}
      },
      "id": "c3d4e5f6-0006-4c00-8000-000000000006",
      "name": "Collection & Publish",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ],
      "credentials": {
        "imageStepApi": {
          "id": "REPLACE_ME",
          "name": "ImageStep account"
        }
      }
    },
    {
      "parameters": {
        "resource": "asset",
        "operation": "get",
        "assetId": "={{ $('Date & Place Collection').item.json.assetId }}"
      },
      "id": "c3d4e5f6-0007-4c00-8000-000000000007",
      "name": "Published Asset",
      "type": "n8n-nodes-imagestep.imageStep",
      "typeVersion": 1,
      "position": [
