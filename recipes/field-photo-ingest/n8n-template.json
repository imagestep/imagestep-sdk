{
  "name": "ImageStep recipe — field photo ingest: Drive HEIC → EXIF date + GPS → label → publish → manifest Sheet",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
